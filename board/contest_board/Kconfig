#
# VelaGuard configuration.  The official SiFli BSP is selected from
# configs/nsh/defconfig, so ARCH_BOARD_CONTEST2026_148_BOARD enables
# contest-specific source files alongside the BSP.
#

if ARCH_BOARD_CONTEST2026_148_BOARD

# The custom board uses the official SiFli Huangshan Pi BSP.  Import its
# board-driver Kconfig so LCD/touch/audio options in the project defconfig are
# recognized during the NuttX configuration pass.
source "$TOPDIR/../vendor/sifli/boards/sf32lb52/drivers/lcd/Kconfig"
source "$TOPDIR/../vendor/sifli/boards/sf32lb52/drivers/input/Kconfig"

config ARCH_BOARD_CONTEST2026_148_BOARD_TAG
	string "Board tag"
	default "contest2026_148_board"

endif
