# VelaGuard Huangshan Pi build configuration.
#
# This is a project-owned snapshot of the official Huangshan Pi NSH
# configuration.  It deliberately reuses the official SiFli BSP through
# CONFIG_ARCH_BOARD_CUSTOM_DIR, while keeping VelaGuard enablement in the
# contest repository so a teammate can reproduce the build from this branch.
#
CONFIG_ALLSYMS=y
CONFIG_ADC=y
CONFIG_ANALOG=y
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../vendor/sifli/boards/sf32lb52/lckfb_huangshan_pi"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="nsh"
CONFIG_ARCH_BOARD_CONTEST2026_148_BOARD=y
CONFIG_ARCH_CHIP_SF32LB52=y
CONFIG_ARCH_CHIP_ARM_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM_DIR="../vendor/sifli/chips/sf32lb52"
CONFIG_ARCH_CHIP_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_CHIP_CUSTOM_NAME="sf32lb52"
CONFIG_ARCH_CHIP_DEBUG_H=y
CONFIG_ARCH_FPU=y
CONFIG_DEFAULT_TASK_STACKSIZE=16096
# CONFIG_ARCH_RAMVECTORS=y
# CONFIG_ARCH_STACKDUMP=y
CONFIG_ARCH_STDARG_H=y
CONFIG_ARCH_SETJMP_H=y
CONFIG_ARMV8M_SYSTICK=y
CONFIG_BOARD_EARLY_INITIALIZE=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_BOARD_LOOPSPERMSEC=8499
CONFIG_BUILTIN=y
CONFIG_DEBUG_ASSERTIONS=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_WARN=y
CONFIG_DEBUG_SCHED=y
# CONFIG_DEV_LOOP is not set
# CONFIG_DEV_ZERO is not set
CONFIG_DEV_NULL=y
CONFIG_DEV_URANDOM=y
CONFIG_DEV_URANDOM_XORSHIFT128=y
CONFIG_DRIVERS_WIRELESS=y
CONFIG_DRIVERS_BLUETOOTH=y
CONFIG_LIBUV=y
CONFIG_LIBUV_THREADPOOL_SIZE=1
CONFIG_LIBUV_THREAD_STACKSIZE=8192
CONFIG_LIBUV_THREADPOOL_PRIORITY=100
CONFIG_LIBUV_STREAM_READ_BUF_SIZE=4096
# CONFIG_LIBUV_BACKEND_EPOLL is not set
CONFIG_LIBUV_EXTENSION=y
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=32768
CONFIG_SYSTEM_WORKQUEUE_NO_YIELD=y
CONFIG_UNQLITE=y
CONFIG_BLUETOOTH=y
CONFIG_BLUETOOTH_FRAMEWORK=y
CONFIG_BLUETOOTH_FRAMEWORK_LOCAL=y
# CONFIG_BLUETOOTH_BREDR_SUPPORT is not set
CONFIG_BLUETOOTH_BLE_SUPPORT=y
CONFIG_BLUETOOTH_BLE_ADV=y
CONFIG_BLUETOOTH_LE_ADVERTISER_MAX_NUM=1
CONFIG_BLUETOOTH_SERVICE=y
# CONFIG_BLUETOOTH_STACK_BREDR_ZBLUE is not set
CONFIG_BLUETOOTH_STACK_LE_ZBLUE=y
CONFIG_BLUETOOTH_STORAGE_UNQLITE_SUPPORT=y
CONFIG_BLUETOOTH_SERVICE_HCI_UART_NAME="/dev/ttyHCI0"
# CONFIG_BLUETOOTH_TOOLS is not set
# CONFIG_BLUETOOTH_LOG is not set
CONFIG_BLUETOOTH_GATT_SERVER=y
CONFIG_BLUETOOTH_GATTS_MAX_CONNECTIONS=1
CONFIG_BLUETOOTH_GATTS_MAX_ATTRIBUTE_NUM=10
# CONFIG_BLUETOOTH_GATT_CLIENT is not set
CONFIG_BT=y
# VelaGuard is an LE Peripheral/GATT Server.  BR/EDR and the LE Central/GATT
# Client roles pull SMP/ECC initialization into the system work queue, but are
# not used by the phone-facing protocol.
# CONFIG_BT_CLASSIC is not set
CONFIG_BT_H4=y
CONFIG_BT_EXT_ADV=y
CONFIG_BT_EXT_ADV_LEGACY_SUPPORT=y
CONFIG_BT_CONN=y
CONFIG_BT_MAX_CONN=1
# CONFIG_BT_HCI_ACL_FLOW_CONTROL is not set
CONFIG_BT_POWER_MODE_CONTROL=y
# The phone connects to this device as a GATT client.  This firmware is the
# LE peripheral/GATT server and does not initiate outbound GATT connections.
CONFIG_BT_PERIPHERAL=y
# CONFIG_CONTEST2026_148_VELAGUARD_HEADLESS is not set
# VelaGuard uses a fixed phone-facing peripheral identity.  Avoid RPA/random
# address refresh during advertising restart; SF32LB52 may timeout on
# LE Set Random Address while restarting advertising after disconnect.
# CONFIG_BT_PRIVACY is not set
CONFIG_BT_HOST_CRYPTO=y
# Use the SF32LB52 controller HCI random command instead of initializing the
# PSA DRBG from the Bluetooth init work queue.  The latter opens /dev/urandom
# during early bring-up and can fault while the VelaGuard process is starting.
# CONFIG_BT_HOST_CRYPTO_PRNG is not set
CONFIG_CRYPTO_MBEDTLS=y
CONFIG_MBEDTLS_PSA_CRYPTO_C=y
# VelaGuard's phone link is a plain GATT peripheral protocol.  Pairing is not
# required by the app protocol, but zblue Classic/SMP needs host crypto helpers.
# CONFIG_BT_SMP_ENFORCE_MITM is not set
CONFIG_BT_MAX_PAIRED=1
# CONFIG_BT_GAP_AUTO_UPDATE_CONN_PARAMS is not set
# CONFIG_BT_AUTO_PHY_UPDATE is not set
# CONFIG_BT_PHY_UPDATE is not set
# CONFIG_BT_AUTO_DATA_LEN_UPDATE is not set
# CONFIG_BT_GATT_CACHING is not set
CONFIG_BT_GATT_DYNAMIC_DB=y
CONFIG_BT_DEVICE_NAME_DYNAMIC=y
# CONFIG_BT_AVCTP is not set
# CONFIG_BT_AVRCP is not set
# CONFIG_BT_NATIVE is not set
CONFIG_BT_UART_ON_DEV_NAME="/dev/ttyHCI0"
CONFIG_ETC_ROMFS=y
CONFIG_EXAMPLES_HELLO=y
# CONFIG_EXAMPLES_HCITEST is not set
CONFIG_EXAMPLES_IPCQTEST=y
CONFIG_EXAMPLES_ADC=y
