diff --git a/subsys/bluetooth/host/hci_core.c b/subsys/bluetooth/host/hci_core.c
--- a/subsys/bluetooth/host/hci_core.c
+++ b/subsys/bluetooth/host/hci_core.c
@@ -3517,5 +3517,9 @@ static int set_le_event_mask(struct bt_dev *hdev)
 		mask |= BT_EVT_MASK_LE_CONN_UPDATE_COMPLETE;
 		mask |= BT_EVT_MASK_LE_REMOTE_FEAT_COMPLETE;
 
-		if (BT_FEAT_LE_CONN_PARAM_REQ_PROC(hdev->le.features)) {
+		/* An external controller owns the connection procedure.  The SF32
+		 * H4 controller emits this event but does not accept the required
+		 * LE Connection Parameter Request Reply command. */
+		if (IS_ENABLED(CONFIG_BT_CENTRAL) &&
+		    BT_FEAT_LE_CONN_PARAM_REQ_PROC(hdev->le.features)) {
 			mask |= BT_EVT_MASK_LE_CONN_PARAM_REQ;
 		}
