diff --git a/service/profiles/gatt/gatts_service.c b/service/profiles/gatt/gatts_service.c
--- a/service/profiles/gatt/gatts_service.c
+++ b/service/profiles/gatt/gatts_service.c
@@ -112,3 +112,5 @@ static gatts_manager_t g_gatts_manager = {
 /* Service IDs are assigned in 0x100-sized groups.  Keep a direct index so
  * incoming ATT operations do not need to walk the mutable service list. */
 static gatts_service_t* g_gatts_service_by_group[UINT8_MAX + 1];
+static gatts_service_t* g_gatts_single_service;
+static uint8_t g_gatts_service_count;
@@ -158,6 +160,12 @@ static gatts_service_t* find_gatts_service_by_id(uint16_t srv_id)
     if (service && service->srv_id == srv_id) {
         return service;
     }
 
+    /* A peripheral with one registered service receives only attributes of
+     * that service.  Avoid walking a damaged list node in this hot path. */
+    if (g_gatts_service_count == 1 && g_gatts_single_service) {
+        return g_gatts_single_service;
+    }
+
     return bt_list_find(g_gatts_manager.services, service_id_cmp, &srv_id);
 }
@@ -389,5 +397,7 @@ static bt_status_t if_gatts_init(void)
 
     memset(&g_gatts_manager, 0, sizeof(g_gatts_manager));
     memset(g_gatts_service_by_group, 0, sizeof(g_gatts_service_by_group));
+    g_gatts_single_service = NULL;
+    g_gatts_service_count = 0;
     g_gatts_manager.started = false;
 
@@ -462,4 +472,6 @@ static bt_status_t if_gatts_shutdown(profile_on_shutdown_t cb)
     manager->pend_ops = NULL;
     memset(g_gatts_service_by_group, 0, sizeof(g_gatts_service_by_group));
+    g_gatts_single_service = NULL;
+    g_gatts_service_count = 0;
     manager->started = false;
     pthread_mutex_unlock(&manager->device_lock);
@@ -539,5 +551,7 @@ static bt_status_t if_gatts_register_service(void* remote, void** phandle, gatt
 
     bt_list_add_tail(g_gatts_manager.services, service);
     g_gatts_service_by_group[service->srv_id >> 8] = service;
+    g_gatts_service_count++;
+    g_gatts_single_service = g_gatts_service_count == 1 ? service : NULL;
     pthread_mutex_unlock(&g_gatts_manager.device_lock);
 
@@ -572,5 +586,11 @@ static bt_status_t if_gatts_unregister_service(void* srv_handle)
     if (g_gatts_service_by_group[service->srv_id >> 8] == service) {
         g_gatts_service_by_group[service->srv_id >> 8] = NULL;
     }
+    if (g_gatts_service_count > 0) {
+        g_gatts_service_count--;
+    }
+    if (g_gatts_single_service == service || g_gatts_service_count == 0) {
+        g_gatts_single_service = NULL;
+    }
     bt_list_remove(g_gatts_manager.services, service);
     pthread_mutex_unlock(&g_gatts_manager.device_lock);
