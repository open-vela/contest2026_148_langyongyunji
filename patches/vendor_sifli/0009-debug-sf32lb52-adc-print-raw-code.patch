diff --git a/chips/sf32lb52/sf32lb_adc.c b/chips/sf32lb52/sf32lb_adc.c
index 4da8ae6..3fc27fc 100644
--- a/chips/sf32lb52/sf32lb_adc.c
+++ b/chips/sf32lb52/sf32lb_adc.c
@@ -42,6 +42,8 @@ struct adc_info_s
     float adc_vol_ratio;
     uint32_t adc_thd_reg;
     uint32_t ref;
+    uint16_t vbat_reg;
+    uint16_t vbat_mv;
     uint8_t initialized;
 };
 
@@ -227,6 +229,22 @@ static void sf32lb_adc_calibrate(struct adc_info_s *priv)
 
     syslog(LOG_INFO, "ADC calibration ratio=%d offset=%d\n",
            (int)priv->adc_vol_ratio, (int)priv->adc_vol_offset);
+
+    /* VBAT monitor: use the widest LDOREF reference (0.65 V) so the
+     * internal divider never saturates for batteries up to ~4.7 V. */
+    __HAL_ADC_SET_LDO_REF_SEL(&priv->adc_handle, 0xF);
+
+    /* Battery calibration point, one-point measured: raw 3627 @ 4020 mV
+     * (LCKFB Huangshan Pi, measured with multimeter). */
+    priv->vbat_reg = 3627;
+    priv->vbat_mv = 4020;
+
+    syslog(LOG_INFO, "ADC CFG_REG1=0x%08lx LDOVREF_SEL=%lu VBAT cal=%u/%u\n",
+           (unsigned long)priv->adc_handle.Instance->ADC_CFG_REG1,
+           (unsigned long)((priv->adc_handle.Instance->ADC_CFG_REG1 &
+                            GPADC_ADC_CFG_REG1_ANAU_GPADC_LDOVREF_SEL_Msk) >>
+                           GPADC_ADC_CFG_REG1_ANAU_GPADC_LDOVREF_SEL_Pos),
+           priv->vbat_reg, priv->vbat_mv);
 }
 
 static void adc_read_work(struct adc_dev_s *dev)
@@ -248,6 +266,9 @@ static void adc_read_work(struct adc_dev_s *dev)
 
     value = adc_read(adc_handle, ctx->channel);
 
+    syslog(LOG_INFO, "ADC raw=%lu ch=%u\n",
+           (unsigned long)value, ctx->channel);
+
     offset = ctx->adc_vol_offset;
     ratio = ctx->adc_vol_ratio;
     if (ratio <= 0.0f)
@@ -255,7 +276,17 @@ static void adc_read_work(struct adc_dev_s *dev)
         ratio = 1000.0f;
     }
 
-    adc_mv = (int32_t)(((float)value - offset) * ratio / 1000.0f);
+    if (ctx->channel == ADC_CHAN_VBAT && ctx->vbat_reg != 0)
+    {
+        /* VBAT monitor channel: linear through the factory calibration
+         * point (vbat_reg @ vbat_mv). */
+        adc_mv = (int32_t)((uint32_t)value * ctx->vbat_mv / ctx->vbat_reg);
+    }
+    else
+    {
+        adc_mv = (int32_t)(((float)value - offset) * ratio / 1000.0f);
+    }
+
     if (adc_mv < 0)
     {
         adc_mv = 0;
