+static void sf32lb52_bt_log_packet(const char *direction,
+                                   const uint8_t *data, size_t len,
+                                   uint32_t rd_ptr, uint32_t wr_ptr)
+{
+  uint16_t opcode = 0;
+  uint8_t event = 0;
+
+  if (data == NULL || len == 0)
+    {
+      return;
+    }
+
+  if (data[0] == SF32LB52_BT_H4_CMD && len >= 3)
+    {
+      opcode = (uint16_t)data[1] | ((uint16_t)data[2] << 8);
+    }
+  else if (data[0] == 0x04 && len >= 3)
+    {
+      event = data[1];
+      if (event == 0x0e && len >= 6)
+        {
+          opcode = (uint16_t)data[4] | ((uint16_t)data[5] << 8);
+        }
+      else if (event == 0x0f && len >= 7)
+        {
+          opcode = (uint16_t)data[5] | ((uint16_t)data[6] << 8);
+        }
+    }
+
+  syslog(LOG_INFO,
+         "sf32lb52 bt %s: h4=%02x len=%lu event=%02x opcode=%04x rd=%08lx wr=%08lx\n",
+         direction, data[0], (unsigned long)len, event, opcode,
+         (unsigned long)rd_ptr, (unsigned long)wr_ptr);
+}
