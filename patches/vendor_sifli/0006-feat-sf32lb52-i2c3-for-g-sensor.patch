diff --git a/boards/sf32lb52/lckfb_huangshan_pi/src/sifli_ap.c b/boards/sf32lb52/lckfb_huangshan_pi/src/sifli_ap.c
--- a/boards/sf32lb52/lckfb_huangshan_pi/src/sifli_ap.c
+++ b/boards/sf32lb52/lckfb_huangshan_pi/src/sifli_ap.c
@@ -45,6 +45,7 @@
 #include <nuttx/board.h>
 #include <nuttx/lcd/lcd.h>
 #include <nuttx/lcd/lcd_dev.h>
+#include <nuttx/sensors/lsm6dsl.h>
 #include <nuttx/timers/pwm.h>
 #include <nuttx/timers/timer.h>
 #include <nuttx/video/fb.h>
@@ -114,6 +114,47 @@
 #ifdef CONFIG_INPUT_FT6146
 int ft6146_touch_initialize(struct i2c_master_s *i2c, uint32_t irq_pin);
 #endif
+
+#if defined(CONFIG_I2C) && defined(CONFIG_SENSORS_LSM6DSL)
+static int board_lsm6dsl_initialize(void)
+{
+  struct i2c_master_s *i2c2;
+  int ret;
+
+  BSP_GPIO_Set(30, 1, 1);
+  usleep(5000);
+  HAL_PIN_Set(PAD_PA40, I2C3_SCL, PIN_PULLUP, 1);
+  HAL_PIN_Set(PAD_PA39, I2C3_SDA, PIN_PULLUP, 1);
+
+  i2c2 = sifli_i2cbus_initialize(2);
+  if (i2c2 == NULL)
+    {
+      syslog(LOG_ERR, "ERROR: sifli_i2cbus_initialize(2) failed\n");
+      return -ENODEV;
+    }
+
+  ret = i2c_register(i2c2, 2);
+  if (ret < 0 && ret != -EEXIST)
+    {
+      syslog(LOG_ERR, "ERROR: i2c_register(/dev/i2c2) failed: %d\n", ret);
+      return ret;
+    }
+
+  ret = lsm6dsl_sensor_register("/dev/lsm6dsl0", i2c2,
+                                LSM6DSLACCEL_ADDR0);
+  if (ret < 0 && ret != -EEXIST)
+    {
+      syslog(LOG_ERR,
+             "ERROR: lsm6dsl_sensor_register(/dev/lsm6dsl0) failed: %d\n",
+             ret);
+      return ret;
+    }
+
+  syslog(LOG_INFO,
+         "INFO: LSM6DSL sensor registered at /dev/lsm6dsl0 (addr=0x6a)\n");
+  return OK;
+}
+#endif

 #if defined(CONFIG_SPI) && defined(CONFIG_BSP_USING_SPI1)
 static struct spi_dev_s *g_sf32lb52_spi1;
@@ -462,4 +504,13 @@ int lckfb_huangshan_pi_bringup(void)
         }
     }
 #endif /* CONFIG_BSP_USING_I2C2 */
+
+#if defined(CONFIG_BSP_USING_I2C3) && defined(CONFIG_SENSORS_LSM6DSL)
+  ret = board_lsm6dsl_initialize();
+  if (ret < 0 && ret != -EEXIST)
+    {
+      syslog(LOG_ERR, "ERROR: board_lsm6dsl_initialize failed: %d\n", ret);
+      return ret;
+    }
+#endif
 #endif /* CONFIG_I2C */
