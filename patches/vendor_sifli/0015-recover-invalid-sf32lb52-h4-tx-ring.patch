diff --git a/chips/sf32lb52/sf32lb52_bt_adapter.c b/chips/sf32lb52/sf32lb52_bt_adapter.c
--- a/chips/sf32lb52/sf32lb52_bt_adapter.c
+++ b/chips/sf32lb52/sf32lb52_bt_adapter.c
@@ -319,4 +319,29 @@ static size_t sf32lb52_bt_ring_write(struct circular_buf *tx_ring,
   return len;
 }
+
+static bool sf32lb52_bt_tx_ring_valid(struct circular_buf *tx_ring)
+{
+  uint32_t rd_idx = CB_GET_PTR_IDX(tx_ring->read_idx_mirror);
+  uint32_t wr_idx = CB_GET_PTR_IDX(tx_ring->write_idx_mirror);
+
+  return tx_ring->buffer_size ==
+           (int16_t)(SF32LB52_BT_TX_BUF_SIZE - sizeof(*tx_ring)) &&
+         rd_idx <= (uint32_t)tx_ring->buffer_size &&
+         wr_idx <= (uint32_t)tx_ring->buffer_size;
+}
+
+static void sf32lb52_bt_reset_tx_ring(struct circular_buf *tx_ring)
+{
+  uint8_t *pool = (uint8_t *)(tx_ring + 1);
+  uint8_t *alias_pool =
+      (uint8_t *)((struct circular_buf *)SF32LB52_BT_TX_BUF_ALIAS + 1);
+  int16_t size = SF32LB52_BT_TX_BUF_SIZE - sizeof(*tx_ring);
+
+  circular_buf_wr_init(tx_ring, pool, size);
+  circular_buf_rd_init(tx_ring, alias_pool, size);
+  up_clean_dcache((uintptr_t)tx_ring,
+                  (uintptr_t)tx_ring + sizeof(*tx_ring));
+  __DSB();
+}
 
 static void sf32lb52_bt_log_packet(const char *direction,
@@ -915,4 +937,5 @@ int sf32lb52_host_send_packet(const uint8_t *data, uint16_t len)
   size_t written;
   uint32_t wr_ptr;
   bool acl_write_logged;
+  bool tx_ring_recovered;
   int ret;
@@ -956,2 +979,14 @@ int sf32lb52_host_send_packet(const uint8_t *data, uint16_t len)
   wr_ptr = 0;
   acl_write_logged = false;
+  tx_ring_recovered = false;
+
+  if (!sf32lb52_bt_tx_ring_valid(tx_ring))
+    {
+      syslog(LOG_WARNING,
+             "sf32lb52 bt tx ring invalid before wait: buf=%d rd=%08lx wr=%08lx\n",
+             tx_ring->buffer_size,
+             (unsigned long)tx_ring->read_idx_mirror,
+             (unsigned long)tx_ring->write_idx_mirror);
+      sf32lb52_bt_reset_tx_ring(tx_ring);
+      tx_ring_recovered = true;
+    }
@@ -976,4 +1011,24 @@ int sf32lb52_host_send_packet(const uint8_t *data, uint16_t len)
   if (ret < 0)
     {
       goto unlock;
     }
+
+  up_invalidate_dcache((uintptr_t)SF32LB52_BT_TX_BUF_ADDR,
+                      (uintptr_t)SF32LB52_BT_TX_BUF_ADDR +
+                      sizeof(*tx_ring));
+  if (!sf32lb52_bt_tx_ring_valid(tx_ring))
+    {
+      if (tx_ring_recovered)
+        {
+          syslog(LOG_ERR,
+                 "sf32lb52 bt tx ring remains invalid: buf=%d rd=%08lx wr=%08lx\n",
+                 tx_ring->buffer_size,
+                 (unsigned long)tx_ring->read_idx_mirror,
+                 (unsigned long)tx_ring->write_idx_mirror);
+          ret = -EIO;
+          goto unlock;
+        }
+
+      sf32lb52_bt_reset_tx_ring(tx_ring);
+      tx_ring_recovered = true;
+    }
